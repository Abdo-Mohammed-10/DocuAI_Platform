{
  "title": "Smart Doc — System Metrics",
  "uid": "DocuAI-system",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "pg_stat_activity_count"}
      ]
    },
    {
      "id": 2,
      "title": "Redis Memory Used",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "redis_memory_used_bytes"}
      ]
    },
    {
      "id": 3,
      "title": "HTTP Requests by Service (rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (job, handler, status)",
          "legendFormat": "{{job}} - {{handler}} - {{status}}"
        }
      ]
    }
  ]
}
